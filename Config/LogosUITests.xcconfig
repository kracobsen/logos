// The LogosUITests target (XCUITest: the smoke test and the performance tests), in every configuration.
// It inherits the project-level settings (Base.xcconfig via Debug/Release/Performance); these override the app's.

PRODUCT_NAME = LogosUITests
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).logos.uitests
TEST_TARGET_NAME = Logos
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE =
CODE_SIGN_ENTITLEMENTS =
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
ENABLE_PREVIEWS = NO
SWIFT_EMIT_LOC_STRINGS = NO
// XCTestCase isn't main-actor isolated; the test classes say @MainActor themselves.
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
